-- no role to assume
requires a non-empty `aws_role_arn`
-- static keys are a second identity
cannot be combined with `aws_access_key_id`
-- AWS STS is not an OAuth token endpoint
only supported for `catalog_type = 'rest'`
-- accepted, and the role stays visible while the token does not appear at all
oauth_forward_user_token = 1
arn:aws:iam::123456789012:role/r
-- fail closed: this session has no token to exchange
enable_token_forwarding
