<clickhouse>
    <storage_configuration>
        <disks>
            <!-- Read-only window over a copy of the pool: takes no mount lease.
                 One attempt is budgeted at 30 s, so no request fits before a one-second deadline. -->
            <cas_ro_05488>
                <type>object_storage</type>
                <object_storage_type>local</object_storage_type>
                <metadata_type>cas</metadata_type>
                <cas_server_root_id>stateless-05488-ro</cas_server_root_id>
                <path from_env="TEST_DISK_05488_POOL"></path>
                <readonly>true</readonly>
                <cas_gc_enabled>0</cas_gc_enabled>
                <cas_attempt_timeout_ms>30000</cas_attempt_timeout_ms>
                <cas_request_window_ms>120000</cas_request_window_ms>
            </cas_ro_05488>
        </disks>
    </storage_configuration>
</clickhouse>
