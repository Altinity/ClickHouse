<clickhouse>
    <storage_configuration>
        <disks>
            <!-- Read-only window over the pool a live server owns: takes no mount lease. -->
            <cas_ro_05393>
                <type>object_storage</type>
                <object_storage_type>local</object_storage_type>
                <metadata_type>cas</metadata_type>
                <cas_server_root_id>stateless-05393-ro</cas_server_root_id>
                <path from_env="TEST_DISK_05393_POOL"></path>
                <readonly>true</readonly>
                <cas_gc_enabled>0</cas_gc_enabled>
            </cas_ro_05393>
            <local_05393>
                <type>local</type>
                <path from_env="TEST_DISK_05393_LOCAL"></path>
            </local_05393>
        </disks>
    </storage_configuration>
</clickhouse>
