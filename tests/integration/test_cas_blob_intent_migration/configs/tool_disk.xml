<clickhouse>
    <storage_configuration>
        <disks>
            <!-- Read-only window over the pool for `clickhouse-disks cas-migrate-pool`: the tool must not mount it. -->
            <disk_cas_migrate>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <http_keep_alive_timeout>30</http_keep_alive_timeout>
                <http_keep_alive_max_requests>10000</http_keep_alive_max_requests>
                <cas_server_root_id>upgrade_node</cas_server_root_id>
                <endpoint>http://rustfs1:11121/test/migration_pool/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
                <readonly>true</readonly>
                <cas_gc_enabled>0</cas_gc_enabled>
            </disk_cas_migrate>
        </disks>
    </storage_configuration>
</clickhouse>
