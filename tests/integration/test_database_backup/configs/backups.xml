<clickhouse>
    <storage_configuration>
        <disks>
            <backup_disk_local>
                <type>local</type>
                <path>/backups/</path>
            </backup_disk_local>
            <backup_disk_s3_plain>
                <type>s3_plain</type>
                <endpoint>http://minio1:9001/root/data/disks/disk_s3_plain/</endpoint>
                <access_key_id>minio</access_key_id>
                <secret_access_key>ClickHouse_Minio_P@ssw0rd</secret_access_key>
            </backup_disk_s3_plain>
            <backup_disk_object_storage_local_plain>
                <type>object_storage</type>
                <object_storage_type>local_blob_storage</object_storage_type>
                <metadata_type>plain</metadata_type>
                <path>/local_plain/</path>
            </backup_disk_object_storage_local_plain>
            <backup_disk_s3_plain_rustfs>
                <type>s3_plain</type>
                <endpoint>http://rustfs1:11121/test/backup_disk_s3_plain_rustfs/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
            </backup_disk_s3_plain_rustfs>
            <cas>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <cas_server_root_id>itest-database-backup</cas_server_root_id>
                <endpoint>http://rustfs1:11121/test/database_backup_cas/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
            </cas>
        </disks>
        <policies>
            <cas_policy>
                <volumes>
                    <single>
                        <disk>cas</disk>
                    </single>
                </volumes>
            </cas_policy>
        </policies>
    </storage_configuration>
    <backups>
        <allowed_disk>backup_disk_local</allowed_disk>
        <allowed_disk>backup_disk_s3_plain</allowed_disk>
        <allowed_disk>backup_disk_object_storage_local_plain</allowed_disk>
        <allowed_disk>backup_disk_s3_plain_rustfs</allowed_disk>
        <allowed_path>/backups</allowed_path>
    </backups>
</clickhouse>
