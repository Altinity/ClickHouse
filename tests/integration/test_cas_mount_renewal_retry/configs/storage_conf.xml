<clickhouse>
    <cas_log>
        <database>system</database>
        <table>cas_log</table>
        <flush_interval_milliseconds>100</flush_interval_milliseconds>
    </cas_log>

    <storage_configuration>
        <disks>
            <disk_cas_renewal>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <cas_server_root_id>itest-cas-renewal</cas_server_root_id>
                <!-- Keep signing/authentication on the normal RustFS path; the shared proxy only
                     changes the TCP destination and preserves the signed Host header. The compiled
                     30s lease TTL and 10s renewal period leave room for bounded physical retries. -->
                <endpoint>http://s3proxy:11121/test/cas_mount_renewal/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
                <cas_gc_enabled>false</cas_gc_enabled>
                <!-- Shortened so a hard-restart test observes the token-stability wait within a
                     bounded test timeout: TTL 1000ms, renew period 200ms, attempt timeout 50ms, safety
                     margin 50ms. The frozen attempt-timeout cap is min(connect_timeout_ms=1000, 50) = 50,
                     so the retry envelope (attempt + 2 * cap = 150) stays well under the shortened TTL:
                     150 + 50 < 1000 and 200 + 300 + 50 < 1000. -->
                <cas_mount_lease_ttl_ms>1000</cas_mount_lease_ttl_ms>
                <cas_mount_renew_period_ms>200</cas_mount_renew_period_ms>
                <cas_attempt_timeout_ms>50</cas_attempt_timeout_ms>
                <cas_lease_safety_margin_ms>50</cas_lease_safety_margin_ms>
            </disk_cas_renewal>
        </disks>
        <policies>
            <cas_mount_renewal>
                <volumes>
                    <main>
                        <disk>disk_cas_renewal</disk>
                    </main>
                </volumes>
            </cas_mount_renewal>
        </policies>
    </storage_configuration>
</clickhouse>
