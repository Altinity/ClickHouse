<clickhouse>
    <profiles>
        <default>
            <!-- Otherwise a catalog error is swallowed and the table list silently comes back empty,
                 which would make every negative assertion in this suite pass for the wrong reason. -->
            <database_datalake_require_metadata_access>1</database_datalake_require_metadata_access>
        </default>
    </profiles>
    <users>
        <default>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
        </default>
        <!-- Authenticates with a password: no token to forward. -->
        <passworduser>
            <password>passworduser_password</password>
            <profile>default</profile>
            <networks><ip>::/0</ip></networks>
        </passworduser>
    </users>
</clickhouse>
