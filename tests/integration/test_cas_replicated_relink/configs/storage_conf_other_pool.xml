<clickhouse>
    <!-- A SECOND, independent content-addressed pool, loaded by node2 only. It exists for exactly one
         assertion: a relink offer is gated on the receiver and the sender naming the SAME pool, so a
         fetch into this pool from a part living in `shared_pool` must degrade to a byte transfer.
         Only one server mounts it, so it needs neither `content_addressed_allow_shared_pool` nor a
         per-instance `server_root_id` override. GC is off: nothing here is ever meant to be reclaimed,
         and a second GC scheduler would only add background noise to the other tests' timing. -->
    <storage_configuration>
        <disks>
            <disk_content_addressed_other>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>content_addressed</metadata_type>
                <endpoint>http://rustfs1:11121/test/other_pool/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
                <server_root_id>node2_other</server_root_id>
                <gc_enabled>0</gc_enabled>
            </disk_content_addressed_other>
        </disks>
        <policies>
            <content_addressed_other>
                <volumes>
                    <main>
                        <disk>disk_content_addressed_other</disk>
                    </main>
                </volumes>
            </content_addressed_other>
        </policies>
    </storage_configuration>
</clickhouse>
