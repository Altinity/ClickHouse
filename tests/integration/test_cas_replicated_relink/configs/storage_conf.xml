<clickhouse>
    <storage_configuration>
        <disks>
            <disk_content_addressed_shared>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>content_addressed</metadata_type>
                <!-- A single shared bucket path. BOTH replicas load this same config, so they mount
                     the SAME content-addressed pool (the bucket is the single source of truth). The
                     shared pool is what makes fetch-by-relink possible: a part written by one replica
                     is already present (as blobs + manifest) for the other to publish a ref to. -->
                <endpoint>http://minio1:9001/root/shared_pool/</endpoint>
                <access_key_id>minio</access_key_id>
                <secret_access_key>ClickHouse_Minio_P@ssw0rd</secret_access_key>
                <!-- Two replicas mounting one pool: mandatory, else the second mounter refuses to
                     attach (PoolMeta ownership check). This is the N-mounter enablement (spec §6). -->
                <content_addressed_allow_shared_pool>1</content_addressed_allow_shared_pool>
                <!-- Background reachability GC enabled on BOTH replicas. The relink's pin-before-publish
                     (spec §4) protects the blobs against a concurrent sweep in the fetch window. -->
                <gc_enabled>1</gc_enabled>
                <content_addressed_gc_grace_sec>3</content_addressed_gc_grace_sec>
                <gc_interval_sec>1</gc_interval_sec>
            </disk_content_addressed_shared>
        </disks>
        <policies>
            <content_addressed_shared>
                <volumes>
                    <main>
                        <disk>disk_content_addressed_shared</disk>
                    </main>
                </volumes>
            </content_addressed_shared>
        </policies>
    </storage_configuration>
</clickhouse>
