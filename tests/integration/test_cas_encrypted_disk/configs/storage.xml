<clickhouse>
    <storage_configuration>
        <disks>
            <disk_cas>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <cas_server_root_id>itest-cas-encrypted-disk</cas_server_root_id>
                <endpoint>http://rustfs1:11121/test/cas_encrypted_disk/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
            </disk_cas>
            <disk_cas_encrypted>
                <type>encrypted</type>
                <disk>disk_cas</disk>
                <path>encrypted/</path>
                <key>1234567812345678</key>
            </disk_cas_encrypted>
            <disk_s3>
                <type>s3</type>
                <endpoint>http://rustfs1:11121/test/plain_s3_encrypted_disk/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
            </disk_s3>
            <disk_s3_encrypted>
                <type>encrypted</type>
                <disk>disk_s3</disk>
                <path>encrypted/</path>
                <key>1234567812345678</key>
            </disk_s3_encrypted>
        </disks>
        <policies>
            <cas>
                <volumes>
                    <main>
                        <disk>disk_cas</disk>
                    </main>
                </volumes>
            </cas>
            <cas_encrypted>
                <volumes>
                    <main>
                        <disk>disk_cas_encrypted</disk>
                    </main>
                </volumes>
            </cas_encrypted>
            <s3_encrypted>
                <volumes>
                    <main>
                        <disk>disk_s3_encrypted</disk>
                    </main>
                </volumes>
            </s3_encrypted>
        </policies>
    </storage_configuration>
</clickhouse>
