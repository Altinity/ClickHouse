<clickhouse>
    <storage_configuration>
        <disks>
            <disk_content_addressed_gc_s3>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>content_addressed</metadata_type>
                <!-- Phase 0 (mount safety): required, validated layout-subtree identity. Single server. -->
                <server_root_id>itest-content-addressed-gc-s3</server_root_id>
                <!-- RustFS (not MinIO) enforces the conditional-PUT/DELETE semantics the CA mount
                     capability probe requires (CasProbe.cpp step 6): MinIO OSS silently honors a
                     mismatched-token DELETE instead of rejecting it, so the fail-closed probe
                     aborted server startup on MinIO (see PR#2073 CI triage). -->
                <endpoint>http://rustfs1:11121/test/cas_gc_data/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
                <!-- Background GC is opt-in (default OFF); enable it and run aggressively so the
                     background sweep actually reclaims orphaned blobs during the test. -->
                <gc_enabled>1</gc_enabled>
                <content_addressed_gc_grace_sec>1</content_addressed_gc_grace_sec>
                <gc_interval_sec>1</gc_interval_sec>
            </disk_content_addressed_gc_s3>
        </disks>
        <policies>
            <content_addressed_gc_s3>
                <volumes>
                    <main>
                        <disk>disk_content_addressed_gc_s3</disk>
                    </main>
                </volumes>
            </content_addressed_gc_s3>
        </policies>
    </storage_configuration>
</clickhouse>
