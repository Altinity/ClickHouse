<clickhouse>
    <storage_configuration>
        <disks>
            <content_addressed_s3>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>content_addressed</metadata_type>
                <!-- RustFS (M-W D-W8): the CA pool needs ENFORCED conditional ops (exact-token
                     DELETE must 412 on mismatch) - MinIO OSS silently ignores If-Match on DELETE
                     and the fail-closed capability probe rejects it. RustFS runs on a dedicated
                     port (11121); MinIO keeps serving the non-CA s3 disks. Bucket `test`, a
                     dedicated key prefix for this disk. -->
                <endpoint>http://localhost:11121/test/content_addressed_s3/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
                <!-- Real server-local scratch dir for the write-buffer spill. -->
                <scratch_path>content_addressed_s3_scratch/</scratch_path>
                <!-- Background GC pacing: the incarnation protocol's fence/recheck handshake
                     replaces the old grace window (M-W D-W5); a short interval so reclamation
                     happens during the run. -->
                <gc_enabled>1</gc_enabled>
                <gc_interval_sec>5</gc_interval_sec>
            </content_addressed_s3>
        </disks>
        <policies>
            <content_addressed_s3>
                <volumes>
                    <main>
                        <disk>content_addressed_s3</disk>
                    </main>
                </volumes>
            </content_addressed_s3>
        </policies>
    </storage_configuration>
    <merge_tree>
        <storage_policy>content_addressed_s3</storage_policy>
    </merge_tree>
    <!-- B86: system logs must not land on the cacheless CA-S3 disk (their flushes would block on minio and
         trip "Timeout exceeded (180s) while flushing system log ... to S3"). Pin them to the local default
         policy; user tables still default to content_addressed_s3 above. -->
    <query_log><storage_policy>default</storage_policy></query_log>
    <query_thread_log><storage_policy>default</storage_policy></query_thread_log>
    <query_views_log><storage_policy>default</storage_policy></query_views_log>
    <part_log><storage_policy>default</storage_policy></part_log>
    <trace_log><storage_policy>default</storage_policy></trace_log>
    <metric_log><storage_policy>default</storage_policy></metric_log>
    <error_log><storage_policy>default</storage_policy></error_log>
    <query_metric_log><storage_policy>default</storage_policy></query_metric_log>
    <asynchronous_metric_log><storage_policy>default</storage_policy></asynchronous_metric_log>
    <!-- opentelemetry_span_log ships an explicit <engine> in the default config, so a sibling
         <storage_policy> is rejected (BAD_ARGUMENTS); bake the policy into the engine SETTINGS instead. -->
    <opentelemetry_span_log>
        <engine>
            engine MergeTree
            partition by toYYYYMM(finish_date)
            order by (finish_date, finish_time_us)
            settings storage_policy = 'default'
        </engine>
    </opentelemetry_span_log>
    <crash_log><storage_policy>default</storage_policy></crash_log>
    <processors_profile_log><storage_policy>default</storage_policy></processors_profile_log>
    <asynchronous_insert_log><storage_policy>default</storage_policy></asynchronous_insert_log>
    <backup_log><storage_policy>default</storage_policy></backup_log>
    <s3queue_log><storage_policy>default</storage_policy></s3queue_log>
    <blob_storage_log><storage_policy>default</storage_policy></blob_storage_log>
    <zookeeper_log><storage_policy>default</storage_policy></zookeeper_log>
    <text_log><storage_policy>default</storage_policy></text_log>
</clickhouse>
