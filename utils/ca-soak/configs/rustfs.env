# RustFS environment for the CA soak pool.
# B167g (2026-06-17): scanner+heal OFF (single-disk ephemeral test pool). NOTE the trade-off:
# with the scanner OFF, RustFS retains every casPut overwrite of the mutable roots/ manifests as a
# distinct on-disk version and never compacts them (roots/ grew to 234 GB / ~1M objects in 73 min,
# filling the disk). Re-enabling the scanner was TRIED and BROKE bring-up (createbucket got an mc
# "signature does not match" during RustFS IAM/startup) — so it is NOT a safe unattended fix. The
# durable fix is the B157 op-count / manifest-rewrite-rate reduction, not RustFS config. For now,
# multi-hour soaks bound the disk by REDUCING the workload op-rate (fewer WORKERS) + the disk
# watchdog, not by compaction.
RUSTFS_SCANNER_ENABLED=false
RUSTFS_HEAL_ENABLED=false
# Credentials the storage_conf.xml CA disk authenticates with (matches the CI harness).
RUSTFS_ACCESS_KEY=clickhouse
RUSTFS_SECRET_KEY=clickhouse
