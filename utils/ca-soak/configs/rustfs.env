# RustFS environment for the CA soak pool.
# Scanner remains OFF because scanner/auto-heal namespace locks produced multi-minute
# `503 ServiceUnavailable` bursts in this single-disk ephemeral fixture. Heal remains OFF because
# the fixture has no redundant disk to repair.
RUSTFS_SCANNER_ENABLED=false
RUSTFS_HEAL_ENABLED=false
RUSTFS_ACCESS_KEY=clickhouse
RUSTFS_SECRET_KEY=clickhouse

# RustFS gates GetObject on a disk-read permit pool and answers `503 SlowDown: disk read concurrency
# limit reached, please reduce your request rate` when the pool is saturated. The default ceiling is
# low enough that an ordinary merge saturates it, and because ClickHouse here retries up to
# `s3_retry_attempts = 500` times without pacing itself (`s3_max_get_rps` is 0), the refusals never
# let concurrency fall back under the ceiling: observed 2026-08-31 as a merge stuck at progress 0.11,
# reading 0 bytes in 40 s with 104 threads parked in RetryRequestSleep and 3,884 of these 503s in
# twelve minutes. Raising the ceiling is the fixture-side half of the fix; pacing the client is the
# other half and belongs in the storage config.
#
# 256 is the value that was MEASURED, not the largest that seemed safe. At the default ceiling a
# 1.1 GiB merge of seven parts never completed: 20 MiB read, zero bytes written across a 40 s window,
# 3,884 of these 503s in twelve minutes. At 256 the same merge finished — `system.part_log` records
# `MergeParts` at 1,211.7 s with `error = 0`. A check at 1024 was botched (rustfs was restarted
# mid-merge, destroying the experiment), so 1024 has no evidence behind it and is not used.
#
# Two things this does NOT fix, so do not read it as the whole answer. 503s still occur at 256 (579
# in three minutes) while the host is entirely idle — load 0.82, iowait 0%, NVMe — so the ceiling is
# being hit for reasons other than physical disk saturation. And the client still paces itself not at
# all, so those refusals become a very long wait rather than an error.
RUSTFS_OBJECT_MAX_CONCURRENT_DISK_READS=256
