<clickhouse>
    <!-- B168/CA-GC-introspection: enable system.cas_garbage_collection_log (not in the
         stock image config.xml). Short flush interval so soak stats materialize quickly. -->
    <cas_garbage_collection_log>
        <database>system</database>
        <table>cas_garbage_collection_log</table>
        <flush_interval_milliseconds>2000</flush_interval_milliseconds>
    </cas_garbage_collection_log>
</clickhouse>
