<clickhouse>
    <storage_configuration>
        <disks>
            <!-- S24 small-dedup-cache variant: identical to storage_conf_ch1.xml except
                 dedup_cache_bytes is reduced to 1 MiB (default 64 MiB) to exercise the
                 in-memory dedup-hint eviction path.  When the working set of distinct
                 blob heads exceeds 1 MiB, the cache evicts entries, forcing remote
                 HEAD-first probes (CASBlobHeadFirst) on re-insert rather than in-memory
                 CASBlobDeduplicationCacheHit short-circuits.  Correctness / dedup must be
                 preserved via the remote HEAD path; only the in-memory shortcut rate drops. -->
            <ca>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <endpoint>http://rustfs1:11121/test/soak_pool/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
                <server_root_id>ca_soak_ch1</server_root_id>
                <gc_enabled>1</gc_enabled>
                <gc_interval_sec>10</gc_interval_sec>
                <expect_continue_min_bytes>65536</expect_continue_min_bytes>
                <!-- S24: 1 MiB dedup-cache (vs 64 MiB default) to exercise the eviction +
                     remote-HEAD fallback path.  Correctness unchanged: a cache miss still
                     dedups via HEAD before the body PUT (CASBlobBodyPutAvoided stays
                     positive). -->
                <dedup_cache_bytes>1048576</dedup_cache_bytes>
            </ca>

            <!-- Read-only fsck alias — same reduced cache, GC disabled. -->
        </disks>
        <policies>
            <ca>
                <volumes>
                    <main>
                        <disk>ca</disk>
                    </main>
                </volumes>
            </ca>
        </policies>
    </storage_configuration>
</clickhouse>
