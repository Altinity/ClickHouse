<clickhouse>
    <storage_configuration>
        <disks>
            <!-- S38 (rev.6 lease-exclusivity soak card): identical to storage_conf_ch1.xml except
                 materialization_grace_ms is raised well above the 30s default so an unclean-handover
                 restart's T_mat wait is long and unambiguous in system.text_log (S38 asserts on the
                 "materialization grace" LOG_INFO line), and so there is a comfortable window to
                 complete the late-PUT injection + queries between the successor becoming healthy and
                 the pool settling. -->
            <ca>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>content_addressed</metadata_type>
                <endpoint>http://rustfs1:11121/test/soak_pool/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
                <server_root_id>ca_soak_ch1</server_root_id>
                <gc_enabled>1</gc_enabled>
                <gc_interval_sec>10</gc_interval_sec>
                <expect_continue_min_bytes>65536</expect_continue_min_bytes>
                <materialization_grace_ms>45000</materialization_grace_ms>
            </ca>
            <!-- ca_ro read-only fsck disk intentionally omitted from the server config — see
                 configs/fsck_only_ca.xml (F1: UNKNOWN_DISK on restart). -->
        </disks>
        <policies>
            <ca>
                <volumes>
                    <main>
                        <disk>ca</disk>
                    </main>
                </volumes>
            </ca>
        </policies>
    </storage_configuration>
</clickhouse>
