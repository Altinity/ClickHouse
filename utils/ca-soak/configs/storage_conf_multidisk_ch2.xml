<clickhouse>
    <storage_configuration>
        <disks>
            <!-- Same CA disk as storage_conf_ch2.xml (identical endpoint/pool). -->
            <ca>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <endpoint>http://rustfs1:11121/test/soak_pool/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
                <server_root_id>ca_soak_ch2</server_root_id>
                <gc_enabled>1</gc_enabled>
                <gc_interval_sec>10</gc_interval_sec>
                <expect_continue_min_bytes>65536</expect_continue_min_bytes>
            </ca>

            <!-- Two plain local disks — ch2's own container-local filesystem (independent of ch1's).
                 Path kept OUTSIDE /var/lib/clickhouse/disks/ — see storage_conf_multidisk_ch1.xml for
                 why (docker-entrypoint.sh chowns only the leaf of each declared disk path, leaving the
                 shared `disks/` parent root-owned, which then blocks the `ca` disk's own lazily-created
                 /var/lib/clickhouse/disks/ca/cas_scratch/ at server startup). -->
            <local1>
                <type>local</type>
                <path>/var/lib/clickhouse/local_disks/local1/</path>
            </local1>
            <local2>
                <type>local</type>
                <path>/var/lib/clickhouse/local_disks/local2/</path>
            </local2>
        </disks>
        <policies>
            <!-- See storage_conf_multidisk_ch1.xml for the rationale; kept identical on both nodes so
                 either replica can be driven by a scenario card. -->
            <ca_local>
                <volumes>
                    <hot>
                        <disk>local1</disk>
                        <max_data_part_size_bytes>4194304</max_data_part_size_bytes>
                    </hot>
                    <cas>
                        <disk>ca</disk>
                    </cas>
                </volumes>
                <move_factor>0.1</move_factor>
            </ca_local>

            <ca_local3>
                <volumes>
                    <hot>
                        <disk>local1</disk>
                        <disk>local2</disk>
                        <max_data_part_size_bytes>4194304</max_data_part_size_bytes>
                    </hot>
                    <cas>
                        <disk>ca</disk>
                    </cas>
                </volumes>
                <move_factor>0.1</move_factor>
            </ca_local3>
        </policies>
    </storage_configuration>
</clickhouse>
