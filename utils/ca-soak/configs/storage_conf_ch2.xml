<clickhouse>
    <storage_configuration>
        <disks>
            <ca>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>content_addressed</metadata_type>
                <endpoint>http://rustfs1:11121/test/soak_pool/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse</secret_access_key>
                <server_root_id>ca_soak_ch2</server_root_id>
                <gc_enabled>1</gc_enabled>
                <gc_interval_sec>10</gc_interval_sec>
                <root_shards>64</root_shards> <!-- rustfs#3231 margin: 64 keeps shard bodies inline (<128 KiB) even under 10-min fold-cursor lag; the code default is 32 -->
                <expect_continue_min_bytes>65536</expect_continue_min_bytes>
            </ca>
            <!-- ca_ro read-only fsck disk intentionally omitted from the server config — see
                 storage_conf_ch1.xml + configs/fsck_only_ca.xml (F1: UNKNOWN_DISK on restart). -->
        </disks>
        <policies>
            <ca>
                <volumes>
                    <main>
                        <disk>ca</disk>
                    </main>
                </volumes>
            </ca>
        </policies>
    </storage_configuration>
</clickhouse>