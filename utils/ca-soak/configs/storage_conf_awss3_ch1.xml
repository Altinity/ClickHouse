<clickhouse>
    <storage_configuration>
        <disks>
            <!-- Real-AWS variant of the CA soak disk (release-gate: real-S3 GC validation).
                 Same shared-pool layout as storage_conf_ch1.xml, but the endpoint is a live
                 AWS bucket and the credentials come from the ENVIRONMENT
                 (use_environment_credentials reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
                 injected via the git-ignored configs/aws.env by docker-compose-awss3.yml) —
                 no secrets in this committed file.
                 expect_continue_min_bytes override (B187) is rustfs-specific and is not set here. -->
            <ca>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <endpoint>https://test-altinity-support-team.s3.us-east-1.amazonaws.com/ca_live_20260703_r3/soak_pool/</endpoint>
                <region>us-east-1</region>
                <use_environment_credentials>1</use_environment_credentials>
                <server_root_id>ca_live_{replica}</server_root_id>
                <gc_enabled>1</gc_enabled>
                <gc_interval_sec>10</gc_interval_sec>
            </ca>

            <!-- Read-only fsck view over the SAME live pool (mirrors storage_conf_ch1.xml). -->
            <ca_ro>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <endpoint>https://test-altinity-support-team.s3.us-east-1.amazonaws.com/ca_live_20260703_r3/soak_pool/</endpoint>
                <region>us-east-1</region>
                <use_environment_credentials>1</use_environment_credentials>
                <server_root_id>ca_live_{replica}</server_root_id>
                <gc_enabled>0</gc_enabled>
                <readonly>true</readonly>
            </ca_ro>
        </disks>
        <policies>
            <ca>
                <volumes>
                    <main>
                        <disk>ca</disk>
                    </main>
                </volumes>
            </ca>
        </policies>
    </storage_configuration>
</clickhouse>
