<clickhouse>
    <!-- fsck-ONLY config for `clickhouse disks -C /etc/clickhouse-server/fsck-only.xml`.
         The read-only shadow disk of the pool must NOT be visible to the SERVER: MergeTree part
         discovery finds the pool's parts on it and fails table load with UNKNOWN_DISK ("found on
         disk 'ca_ro' which is not defined in the storage policy") - hit live on the GCS stand
         restart 2026-07-03. Product-side follow-up tracked in ROADMAP. -->
    <storage_configuration>
        <disks>

            <!-- Read-only fsck view over the SAME live pool (mirrors storage_conf_ch1.xml). -->
            <ca_ro>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>cas</metadata_type>
                <endpoint>https://storage.googleapis.com/content-adressable-test-mfilimonov/ca_live_20260703_g2/soak_pool/</endpoint>
                <use_environment_credentials>1</use_environment_credentials>
                <!-- The GCS Generation-token binding (spec 2026-07-03): GOOG4-HMAC signing +
                     x-goog conditional dialect. Without this the S3-compat surface silently
                     ignores every precondition and the probe refuses the mount (measured). -->
                <http_client>gcs_hmac</http_client>
                <server_root_id>ca_live_node1</server_root_id> <!-- literal: clickhouse-disks -C does not load the server macros -->
                <gc_enabled>0</gc_enabled>
                <readonly>true</readonly>
            </ca_ro>
        </disks>
    </storage_configuration>
</clickhouse>
