{"cluster_id": "C-2310", "topic": "Applying remove_namespace clears committed refs, precommits, and payloads", "target": "architecture/manifests-and-refs", "member_ids": ["B010-067"], "canonical_claim": "Applying `remove_namespace` clears committed refs, precommits, and payloads, changes state to `Removed`, and makes a second durable remove record corruption; API idempotency returns success after observing `Removed`.", "issue_ids": [], "sources": ["docs/superpowers/specs/2026-07-10-cas-ref-snapshot-log-design.md#namespace-removal"]}
{"cluster_id": "C-2311", "topic": "A successful append leaves no dirty ref-state memory", "target": "architecture/manifests-and-refs", "member_ids": ["B010-070"], "canonical_claim": "A successful append leaves no dirty ref-state memory because the log is authoritative; complete namespace views may be evicted immediately, and eviction never writes storage.", "issue_ids": [], "sources": ["docs/superpowers/specs/2026-07-10-cas-ref-snapshot-log-design.md#byte-bounded-ref-state-cache"]}
