{"cluster_id": "C-2528", "topic": "Namespace discovery does not use a persistent gc/registry; each", "target": "architecture/manifests-and-refs", "member_ids": ["B043-014"], "canonical_claim": "Namespace discovery does not use a persistent `gc/registry`; each namespace has a durable monotone never-reused `incarnation`, and the pool has a global GC `round`, because both coordinates are required to prevent newborn and ABA errors.", "issue_ids": ["D1"], "sources": ["docs/superpowers/cas/how-we-got-here.md#turn-registry"]}
{"cluster_id": "C-2529", "topic": "Ref-log ids are dense 1..T within (namespace, epoch), derived", "target": "architecture/manifests-and-refs", "member_ids": ["B043-036"], "canonical_claim": "Ref-log ids are dense `1..T` within `(namespace, epoch)`, derived from the table's `greatest_applied`; an id can be reused only when no attempt was sent or every sent attempt has conclusive rejection.", "issue_ids": [], "sources": ["docs/superpowers/cas/how-we-got-here.md#turn-contiguous-chain"]}
{"cluster_id": "C-2530", "topic": "The catalog lifecycle reconciler performs no hot ref LIST", "target": "architecture/manifests-and-refs", "member_ids": ["B049-003"], "canonical_claim": "The catalog lifecycle reconciler performs no hot ref `LIST`, ref walk, fold, seal publication, `gc/state` mutation, runtime invalidation, or physical deletion.", "issue_ids": [], "sources": [".superpowers/sdd/2026-07-28-cas-ref-chain-stage-b-catalog/task-5-checkpoint75a-reconciler-report.md#scope"]}
