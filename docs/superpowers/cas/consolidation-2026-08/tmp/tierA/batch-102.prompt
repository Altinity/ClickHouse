{"cluster_id": "C-3171", "topic": "read path claim", "target": "architecture/read-path", "member_ids": ["B015-118"], "canonical_claim": "Reader part discovery comes from the adopted snapshot state through readonly refresh and never from a live object-store LIST.", "issue_ids": [], "sources": ["docs/superpowers/specs/2026-07-14-cas-readonly-replica-snapshot-pin-design.md#refresh"]}
{"cluster_id": "C-3172", "topic": "read path claim", "target": "architecture/read-path", "member_ids": ["B015-119"], "canonical_claim": "A running read-only replica query holds its `DataPart` objects for the query duration, so concurrent refresh changes apply only to new queries.", "issue_ids": [], "sources": ["docs/superpowers/specs/2026-07-14-cas-readonly-replica-snapshot-pin-design.md#refresh"]}
