{"cluster_id": "C-3165", "topic": "read path claim", "target": "architecture/read-path", "member_ids": ["B012-032"], "canonical_claim": "Writer recovery performs one `LIST` of `cas/refs/<ns>/`, selects the greatest snapshot, validates its body, fetches tail logs in ID order, and restarts on a selected object vanishing.", "issue_ids": ["rev.4"], "sources": ["docs/superpowers/plans/2026-07-12-cas-ref-table-snapshot-log-phase1.md#L293-L301"]}
