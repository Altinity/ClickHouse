{"cluster_id": "C-1987", "topic": "CAS listing and exact delete handling", "target": "architecture/garbage-collection", "member_ids": ["B013-033", "B043-078"], "canonical_claim": "CAS listing and exact-delete handling is intended to share a callback-based `forEachListedKey` iterator and a `classifyDeleteOutcome` classifier across GC, fsck, and orphan-manifest cleanup.; GC, orphan sweep, and fsck should share a structured deletion outcome vocabulary: deleted, missing, token mismatch, unsupported, and failed.", "issue_ids": ["A-D4", "A-D5", "A\u00a713.2#3"], "sources": ["docs/superpowers/cas/refactoring-ideas.md#simplify", "docs/superpowers/plans/2026-07-12-cas-stabilization-cleanup.md#L1724-L1879", "docs/superpowers/specs/2026-07-12-cas-stabilization-cleanup-design.md#L151-L157"]}
{"cluster_id": "C-1988", "topic": "GcState fence_seq is write only vestigial", "target": "architecture/garbage-collection", "member_ids": ["B013-040"], "canonical_claim": "`GcState::fence_seq` is write-only vestigial state because GC outcome and retire keys use `(snap_generation, snap_attempt)`; its proto field is removed and field number 3/name `fence_seq` are reserved.", "issue_ids": ["A\u00a79#9"], "sources": ["docs/superpowers/plans/2026-07-12-cas-stabilization-cleanup.md#L1396-L1430"]}
